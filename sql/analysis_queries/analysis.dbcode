cells:
  - kind: 2
    languageId: sql
    value: |
      -- Q1: National generation, emissions and carbon intensity by year
      SELECT year,
             ROUND(gen_twh, 1)                 AS gen_twh,
             ROUND(emissions_mtco2, 1)          AS co2_mt,
             ROUND(co2_intensity_g_per_kwh, 1)  AS intensity_g_kwh
      FROM v_annual ORDER BY year;
  - kind: 2
    languageId: sql
    value: |
      -- Q2: Generation by fuel, TWh, by year
      SELECT year, fuel_name, ROUND(SUM(twh), 2) AS twh
      FROM v_generation_enriched
      GROUP BY year, fuel_name
      ORDER BY year, twh DESC;
  - kind: 2
    languageId: sql
    value: |
      -- Q3: Fuel mix share (%) by year
      SELECT year, fuel_name,
             ROUND(100.0 * SUM(twh) / SUM(SUM(twh)) OVER (PARTITION BY year), 1) AS pct
      FROM v_generation_enriched
      GROUP BY year, fuel_name
      ORDER BY year, pct DESC;
  - kind: 2
    languageId: sql
    value: |
      -- Q4: Coal -- share vs absolute tonnage, 2018 vs 2025 (the headline contrast)
      WITH y AS (
        SELECT year,
               SUM(CASE WHEN fuel_name='Coal' THEN twh END)   AS coal_twh,
               SUM(twh)                                       AS tot_twh,
               SUM(CASE WHEN fuel_name='Coal' THEN mtco2 END) AS coal_mtco2
        FROM v_generation_enriched GROUP BY year
      )
      SELECT year, ROUND(coal_twh,1) coal_twh,
             ROUND(100.0*coal_twh/tot_twh,1) coal_share_pct,
             ROUND(coal_mtco2,1) coal_co2_mt
      FROM y ORDER BY year;
  - kind: 2
    languageId: sql
    value: |
      -- Q5: Year-on-year change in national emissions
      SELECT year,
             ROUND(emissions_mtco2,1) co2_mt,
             ROUND(emissions_mtco2 - LAG(emissions_mtco2) OVER (ORDER BY year), 1) AS yoy_mt,
             ROUND(100.0*(emissions_mtco2/LAG(emissions_mtco2) OVER (ORDER BY year) - 1), 1) AS yoy_pct
      FROM v_annual ORDER BY year;
  - kind: 2
    languageId: sql
    value: |
      -- Q6: Months ranked by total CO2 (top 12) -- the COVID-2020 trough shows up at the bottom
      SELECT month_start, ROUND(total_emissions_mtco2, 2) AS co2_mt,
             RANK() OVER (ORDER BY total_emissions_mtco2 DESC) AS rk
      FROM v_monthly_emissions ORDER BY co2_mt DESC LIMIT 12;
  - kind: 2
    languageId: sql
    value: |
      -- Q7: Seasonality -- average monthly CO2 by calendar month, all years
      SELECT month, ROUND(AVG(total_emissions_mtco2), 2) AS avg_co2_mt
      FROM v_monthly_emissions GROUP BY month ORDER BY month;
  - kind: 2
    languageId: sql
    value: |
      -- Q8: Renewables (hydro + solar + bioenergy) share by year
      SELECT year,
             ROUND(100.0 * SUM(CASE WHEN fuel_name IN ('Hydro','Solar','Bioenergy') THEN twh ELSE 0 END)
                   / SUM(twh), 1) AS renewables_pct
      FROM v_generation_enriched GROUP BY year ORDER BY year;
